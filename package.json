{
  "name": "blueprint-textbook",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm lint:code && pnpm lint:markdown",
    "lint:code": "eslint .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\" \"!node_modules/**\" \"!build/**\" \"!generated/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm validate:content && pnpm validate:links",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:links": "tsx scripts/validate-links.ts",
    "examples:extract": "tsx scripts/examples/extract.ts",
    "examples:typecheck": "tsx scripts/examples/typecheck.ts",
    "examples:test": "jest --selectProjects examples",
    "test": "pnpm test:unit",
    "test:unit": "jest",
    "test:e2e": "playwright test --tsconfig e2e/tsconfig.json",
    "test:a11y": "playwright test --tsconfig e2e/tsconfig.json --grep @a11y",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate && pnpm examples:extract && pnpm examples:typecheck && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-sitemap": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "livecodes": "^0.14.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "~7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^30.0.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unist": "^3.0.0",
    "axe-core": "^4.9.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "markdownlint-cli2": "^0.13.0",
    "mdast-util-from-markdown": "^2.0.0",
    "prettier": "^3.3.0",
    "remark-parse": "^11.0.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.15.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
